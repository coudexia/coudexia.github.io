// Publicación en Cloudflare (Workers con archivos estáticos): sube la carpeta dist/ que genera "npm run build".
// "name" tiene que coincidir con el nombre del proyecto en el panel de Cloudflare.
{
  "name": "coudexia",
  "compatibility_date": "2026-11-16",
  // Con "routes" la dirección workers.dev se apaga sola: la dejamos prendida para no romper links ya compartidos.
  "workers_dev": true,
  // Dominios propios: Cloudflare crea el registro DNS y el certificado al publicar.
  "routes": [
    { "pattern": "coudexia.com.ar", "custom_domain": true },
    { "pattern": "www.coudexia.com.ar", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
