// Publicación en Cloudflare (Workers con archivos estáticos): sube la carpeta dist/ que genera "npm run build".
// "name" tiene que coincidir con el nombre del proyecto en el panel de Cloudflare.
{
  "name": "coudexia",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
