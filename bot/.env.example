# Copiá este archivo como .env y completalo

# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Modelo. claude-opus-5-5 responde mejor pero cuesta unas 40 veces más
BOT_MODEL=claude-haiku-5-5

PORT=3000
# Chat de prueba en http://localhost:3000. Ponelo en 0 si el servidor queda público
CHAT_WEB=1

# WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp). Sirve para todos los números;
# el ID de cada número va en negocios/<negocio>/negocio.json
WA_TOKEN=
# Una palabra que inventás vos y repetís en Meta al configurar el webhook
WA_VERIFY_TOKEN=
# App secret (Configuración de la app > Básica). Sin esto el webhook rechaza todo
WA_APP_SECRET=

# Cuenta de servicio de Google, la misma para todos los negocios.
# El calendario de cada negocio va en negocios/<negocio>/negocio.json
# Archivo .json de la cuenta de servicio. Nunca lo subas a GitHub
GOOGLE_CREDENTIALS=./credenciales-google.json
