---
import { PROCESO } from '../data/coudexia';
---
<section class="seccion proceso" id="proceso">
  <div class="wrap grilla">
    <div class="cabecera">
      <p class="etiqueta rv">Cómo trabajamos</p>
      <h2 class="rv palabras">Un proceso simple, sin sorpresas.</h2>
      <p class="bajada rv">Sabés en qué etapa está tu proyecto y qué sigue en cada momento.</p>
    </div>
    <ol class="pasos">
      {PROCESO.map((p, i) => (
        <li class="paso">
          <span class="num" aria-hidden="true">{i + 1}</span>
          <div><h3>{p.t}</h3><p>{p.d}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // La línea se llena a medida que bajás y cada paso se activa al pasar por el centro de la pantalla
  const lista = document.querySelector<HTMLElement>('.pasos')!;
  const pasos = [...lista.querySelectorAll<HTMLElement>('.paso')];
  let pendiente = false;
  const actualizar = () => {
    pendiente = false;
    const r = lista.getBoundingClientRect(), medio = innerHeight * .55;
    const k = Math.min(1, Math.max(0, (medio - r.top) / r.height));
    lista.style.setProperty('--k', String(k));
    pasos.forEach((p) => p.classList.toggle('activo', p.getBoundingClientRect().top < medio));
  };
  addEventListener('scroll', () => { if (!pendiente) { pendiente = true; requestAnimationFrame(actualizar); } }, { passive: true });
  actualizar();
</script>

<style>
  .grilla { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 40px clamp(40px, 7vw, 96px); align-items: start; }
  .cabecera { display: grid; gap: 18px; position: sticky; top: 120px; }
  .pasos { position: relative; list-style: none; }
  /* Línea del recorrido: gris de fondo y bordó que se llena con --k (0 a 1) */
  .pasos::before, .pasos::after { content: ""; position: absolute; left: 21px; top: 44px; bottom: 44px; width: 2px; background: var(--linea); }
  .pasos::after { background: var(--bordo); transform: scaleY(var(--k, 0)); transform-origin: top; }
  .paso { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 24px; padding: 22px 0; }
  .num { position: relative; z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--marfil); border: 2px solid var(--linea); color: var(--texto-suave); font-weight: 800; transition: background-color .4s, border-color .4s, color .4s, transform .5s var(--ease); }
  .paso.activo .num { background: var(--bordo); border-color: var(--bordo); color: var(--marfil); transform: scale(1.08); }
  h3 { font-size: clamp(1.25rem, 2vw, 1.5rem); letter-spacing: -.02em; margin: 8px 0 6px; color: var(--texto-suave); transition: color .4s; }
  .paso.activo h3 { color: var(--grafito); }
  p { color: var(--texto-suave); max-width: 480px; }

  @media (max-width: 860px) {
    .grilla { grid-template-columns: 1fr; }
    .cabecera { position: static; }
    .paso { gap: 16px; }
  }
</style>
