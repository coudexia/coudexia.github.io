---
import { SERVICIOS } from '../data/coudexia';
---
<section class="seccion" id="servicios">
  <div class="wrap">
    <div class="cabecera">
      <p class="etiqueta rv">Servicios</p>
      <h2 class="rv">Tres formas de llevar tu negocio a internet.</h2>
      <p class="bajada rv">Cada proyecto arranca por lo que necesitás resolver, no por una plantilla.</p>
    </div>

    <ol class="lista">
      {SERVICIOS.map((s, i) => (
        <li class="servicio rv">
          <span class="num">0{i + 1}</span>
          <div class="cuerpo">
            <h3>{s.titulo}</h3>
            <p class="problema">{s.problema}</p>
            <p class="ideal"><b>Ideal para:</b> {s.ideal}</p>
          </div>
          <ul class="items">{s.items.map((it) => <li>{it}</li>)}</ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .cabecera { display: grid; gap: 18px; max-width: 760px; margin-bottom: clamp(40px, 6vw, 72px); }
  .lista { list-style: none; border-top: 1px solid var(--grafito); }
  .servicio { display: grid; grid-template-columns: 80px minmax(0, 1.4fr) minmax(0, 1fr); gap: clamp(20px, 4vw, 56px); padding: clamp(32px, 4vw, 48px) 0; border-bottom: 1px solid var(--linea); transition: background-color .3s; }
  .num { font-size: .9rem; font-weight: 800; color: var(--bordo); padding-top: 8px; }
  h3 { font-size: clamp(1.6rem, 3vw, 2.25rem); margin-bottom: 14px; }
  .problema { color: var(--texto-suave); max-width: 560px; }
  .ideal { margin-top: 16px; font-size: .95rem; max-width: 560px; }
  .ideal b { color: var(--vino); }
  .items { list-style: none; display: grid; gap: 10px; align-content: start; padding-top: 8px; }
  .items li { display: flex; gap: 12px; align-items: baseline; font-weight: 600; font-size: .98rem; }
  .items li::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 2px; background: var(--rosa); transform: translateY(-1px); }

  @media (max-width: 860px) {
    .servicio { grid-template-columns: 1fr; gap: 14px; }
    .num { padding: 0; }
    .items { padding-top: 6px; }
  }
</style>
