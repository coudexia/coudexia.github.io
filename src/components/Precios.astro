---
import { PLANES, LANZAMIENTO, wa } from '../data/coudexia';
// Selector "¿Qué necesitás?": cada necesidad recomienda un plan, con el motivo sacado de lo que incluye ese plan
const NECESIDADES = [
  { t: 'Mostrar mis servicios y precios', plan: 'Página Web', por: 'una página clara con tus servicios, precios, ubicación y WhatsApp alcanza para empezar.' },
  { t: 'Promocionar un servicio puntual', plan: 'Página Web', por: 'una landing enfocada en un solo objetivo convierte mejor que un sitio grande.' },
  { t: 'Que reserven turno sin salir de mi web', plan: 'Web Pro', por: 'el calendario de turnos queda integrado en tu web, con un tipo de turno por servicio.' },
  { t: 'Una web completa con galería y más', plan: 'Web Pro', por: 'hasta 5 páginas: servicios y precios, galería, nosotros y preguntas frecuentes.' },
];
---
<section class="seccion" id="precios">
  <div class="wrap">
    <div class="cabecera">
      <div>
        <p class="etiqueta rv">Planes y precios</p>
        <h2 class="rv palabras">Elegí tu plan y arrancamos.</h2>
      </div>
      <p class="bajada rv">Precios en pesos argentinos: un pago inicial por el diseño y el desarrollo, y un mensual por el hosting, el mantenimiento y el soporte. Escribinos por WhatsApp con el plan que te interesa y vemos tu caso.</p>
    </div>

    <div id="planes" class="ancla">
    {LANZAMIENTO.quedan > 0 && (
      <div class="lanza rv">
        <p class="lanza-txt"><span class="alerta" aria-hidden="true"></span><span><b>Precio de lanzamiento:</b> quedan <b class="quedan">{LANZAMIENTO.quedan} de {LANZAMIENTO.cupos}</b> lugares</span></p>
        <span class="cupo" aria-hidden="true"><i style={`--k:${(LANZAMIENTO.cupos - LANZAMIENTO.quedan) / LANZAMIENTO.cupos}`}></i></span>
        <p class="lanza-sub">Precio especial + primer mes de mantenimiento bonificado</p>
      </div>
    )}

    <div class="elige rv">
      <p class="elige-q" id="elige-q">¿Qué necesitás para tu negocio?</p>
      <div class="elige-ops" role="group" aria-labelledby="elige-q">
        {NECESIDADES.map((n) => (
          <button type="button" aria-pressed="false" data-plan={n.plan} data-por={n.por}
            data-href={wa(`Hola Coudexia! Me interesa el plan ${n.plan}. Lo que necesito: ${n.t.toLowerCase()}.`)}>{n.t}</button>
        ))}
      </div>
      <div class="elige-res" aria-live="polite">
        <p hidden>Te recomendamos <b class="elige-plan"></b>: <span class="elige-por"></span></p>
        <a class="btn btn-principal" href={wa()} target="_blank" rel="noopener" hidden>Consultar por este plan <span class="flecha" aria-hidden="true">→</span></a>
      </div>
    </div>

    <ul class="planes">
      {PLANES.map((p, i) => (
        <li class:list={['plan rv', { destacado: p.destacado }]} style={`--d:${i * .1}s`} data-plan={p.nombre}>
          {p.destacado && <span class="sello">Recomendado</span>}
          <p class="nombre">{p.nombre}</p>
          <p class="para">{p.para}</p>
          <p class="precio">
            <small>Instalación · pago único</small><b>{p.desde}</b>
            <span class="mas"><small>Mantenimiento mensual</small><span>+ <b class="mes">{p.mensual}</b> por mes</span></span>
          </p>
          {p.nota && <p class="nota">{p.nota}</p>}
          <ul class="incluye">
            {p.incluye.map((it, j) => <li style={`--i:${j}`}>{it}</li>)}
            {LANZAMIENTO.quedan > 0 && <li class="extra" style={`--i:${p.incluye.length}`}>1.er mes de mantenimiento bonificado</li>}
          </ul>
          <a class:list={['btn', p.destacado ? 'btn-claro' : 'btn-principal']} href={wa(p.mensaje)} target="_blank" rel="noopener">Quiero este plan <span class="flecha" aria-hidden="true">→</span></a>
          {LANZAMIENTO.quedan > 0 && <p class="ultimos">Quedan {LANZAMIENTO.quedan} lugares a este precio</p>}
        </li>
      ))}
    </ul>
    </div>

    <ul class="condiciones rv">
      <li>Instalación: 50% al confirmar y 50% en la entrega</li>
      <li>Mensual sin permanencia mínima</li>
      <li>Transferencia o Mercado Pago</li>
      <li>Dominio y web a tu nombre</li>
    </ul>
    <p class="aparte rv"><b>No incluido:</b> el costo anual del dominio y, si los necesitás, los planes pagos de la herramienta de turnos; los dos se contratan a tu nombre. Las secciones nuevas, los rediseños y los cambios que superen los de tu plan se presupuestan aparte.</p>
  </div>
</section>

<script>
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cartas = [...document.querySelectorAll<HTMLElement>('.plan')];

  // Selector de necesidades: marca la opción, explica el plan recomendado, resalta su tarjeta y arma el WhatsApp
  const elige = document.querySelector<HTMLElement>('.elige')!;
  const ops = [...elige.querySelectorAll<HTMLButtonElement>('.elige-ops button')];
  const res = elige.querySelector<HTMLParagraphElement>('.elige-res p')!;
  const cta = elige.querySelector<HTMLAnchorElement>('.elige-res a')!;
  ops.forEach((b) => b.addEventListener('click', () => {
    ops.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    res.querySelector('.elige-plan')!.textContent = b.dataset.plan!;
    res.querySelector('.elige-por')!.textContent = b.dataset.por!;
    cta.href = b.dataset.href!;
    res.hidden = cta.hidden = false;
    elige.classList.remove('nuevo'); void elige.offsetWidth; elige.classList.add('nuevo'); // reinicia la entrada del resultado
    cartas.forEach((c) => c.classList.toggle('elegido', c.dataset.plan === b.dataset.plan));
  }));

  // El precio "sube" hasta el valor real cuando la tarjeta entra en pantalla (arranca del 60% para no cambiar de ancho)
  if (!calmo) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      const el = e.target as HTMLElement, fin = el.textContent ?? '', n = Number(fin.replace(/\D/g, ''));
      if (!n) return;
      const t0 = performance.now() + 250;
      const paso = (t: number) => {
        const k = Math.min(Math.max((t - t0) / 1400, 0), 1);
        el.textContent = k < 1 ? '$' + (Math.round(n * (.6 + .4 * (1 - (1 - k) ** 4)) / 1000) * 1000).toLocaleString('es-AR') : fin;
        if (k < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }), { threshold: .8 });
    cartas.forEach((c) => io.observe(c.querySelector('.precio > b')!));
  }

  // Inclinación 3D y luz que sigue al mouse (solo con mouse)
  if (!calmo && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    cartas.forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        if (!c.classList.contains('in')) return;
        const r = c.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
        c.style.setProperty('--mx', `${x * 100}%`);
        c.style.setProperty('--my', `${y * 100}%`);
        c.classList.add('tilt');
        c.style.transform = `perspective(1100px) rotateX(${(.5 - y) * 9}deg) rotateY(${(x - .5) * 9}deg) translateY(-8px)`;
      });
      c.addEventListener('pointerleave', () => { c.classList.remove('tilt'); c.style.transform = ''; });
    });
  }
</script>

<style>
  .cabecera { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 20px 64px; align-items: end; margin-bottom: clamp(40px, 6vw, 64px); }
  .cabecera h2 { margin-top: 18px; }
  /* Destino de los links "Ver Página…" de Servicios: deja el aviso y los planes a la vista */
  .ancla { scroll-margin-top: 24px; }
  /* Aviso de lanzamiento: sin precio tachado, el beneficio es real y tiene límite */
  .lanza { display: grid; gap: 10px; width: min(100%, 520px); margin: 0 auto 40px; padding: 16px 22px 14px; border: 1.5px solid #D8A9BC; border-radius: 18px; background: var(--rosa); color: var(--vino); font-size: .95rem; font-weight: 600; text-align: center; }
  .lanza b { font-weight: 800; }
  .lanza-txt { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .quedan { display: inline-block; padding: 1px 9px; border-radius: 999px; background: var(--vino); color: var(--marfil); }
  /* Punto que late: el aviso está "en vivo" */
  .alerta { flex: none; width: 10px; height: 10px; border-radius: 50%; background: #C2185B; box-shadow: 0 0 0 0 #C2185B88; animation: alerta 1.6s infinite; }
  @keyframes alerta { 70% { box-shadow: 0 0 0 10px #C2185B00; } 100% { box-shadow: 0 0 0 0 #C2185B00; } }
  /* Barra de lugares tomados: se llena cuando el aviso entra en pantalla */
  .cupo { display: block; height: 8px; border-radius: 999px; background: #F7F4F1AA; overflow: hidden; }
  .cupo i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--bordo), #C2185B); transform-origin: left; transform: scaleX(var(--k)); }
  :global(.js) .cupo i { transform: scaleX(0); transition: transform 1.6s var(--ease) .5s; }
  :global(.js) .lanza.in .cupo i { transform: scaleX(var(--k)); }
  .lanza-sub { font-size: .82rem; font-weight: 600; opacity: .85; }
  /* Selector de necesidades */
  .elige { display: grid; justify-items: center; gap: 14px; max-width: 860px; margin: 0 auto 40px; text-align: center; }
  .elige-q { font-size: 1.15rem; font-weight: 800; letter-spacing: -.02em; }
  .elige-ops { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .elige-ops button { min-height: 44px; padding: 0 18px; border: 1.5px solid var(--linea); border-radius: 999px; background: var(--papel); font-weight: 600; font-size: .92rem; cursor: pointer; transition: background-color .2s, border-color .2s, color .2s, transform .16s var(--ease); }
  .elige-ops button:active { transform: scale(.97); }
  .elige-ops button[aria-pressed="true"] { background: var(--bordo); border-color: var(--bordo); color: var(--marfil); }
  .elige-res { display: grid; justify-items: center; gap: 12px; }
  .elige-res p { max-width: 600px; color: var(--texto-suave); }
  .elige-res b { color: var(--vino); }
  .nuevo .elige-res > * { animation: aparece-res .45s var(--ease) both; }
  .nuevo .elige-res > a { animation-delay: .08s; }
  @keyframes aparece-res { from { opacity: 0; transform: translateY(8px); } }
  /* La tarjeta del plan recomendado queda marcada */
  .plan { outline: 3px solid transparent; outline-offset: 10px; transition: opacity .8s var(--ease), transform .8s var(--ease), box-shadow .4s, border-color .3s, outline-color .3s, outline-offset .4s var(--ease); transition-delay: var(--d, 0s), var(--d, 0s), 0s, 0s, 0s, 0s; }
  .elige-res [hidden] { display: none; }
  .plan.elegido { outline-color: var(--bordo); outline-offset: 5px; }
  @media (hover: hover) and (pointer: fine) {
    .elige-ops button:hover { border-color: var(--bordo); }
    .elige-ops button[aria-pressed="true"]:hover { background: var(--bordo-hover); }
  }
  .ultimos { margin-top: 10px; text-align: center; font-size: .82rem; font-weight: 700; color: var(--bordo); }
  .destacado .ultimos { color: var(--rosa); }
  .planes { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: stretch; max-width: 860px; margin-inline: auto; }
  .plan { position: relative; display: flex; flex-direction: column; padding: 34px 30px 30px; background: var(--papel); border: 1px solid var(--linea); border-radius: 22px; transition: opacity .8s var(--ease), transform .8s var(--ease), box-shadow .4s, border-color .3s; transition-delay: var(--d, 0s), var(--d, 0s), 0s, 0s; }
  .js .plan.rv.in:hover { transform: translateY(-6px); }
  .plan:hover { border-color: #D8C6CD; box-shadow: 0 30px 60px -32px #501B3566; }
  .destacado { background: var(--vino); color: var(--marfil); border-color: var(--vino); }
  .sello { position: absolute; top: -13px; left: 30px; padding: 5px 12px; border-radius: 999px; background: var(--rosa); color: var(--vino); font-size: .75rem; font-weight: 800; letter-spacing: .04em; }
  .nombre { font-size: 1.6rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
  .para { margin-top: 10px; color: var(--texto-suave); font-size: .97rem; min-height: 3.2em; }
  .destacado .para, .destacado .nota { color: #D9C3CC; }
  .precio { display: grid; margin: 26px 0 4px; padding-top: 22px; border-top: 1px solid var(--linea); }
  .destacado .precio { border-color: var(--linea-oscura); }
  .precio small { font-size: .82rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--bordo); }
  .destacado .precio small { color: var(--rosa); }
  .precio b { font-size: clamp(2.2rem, 3.6vw, 2.8rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.1; }
  .mas { display: grid; gap: 2px; margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--linea); font-size: 1rem; font-weight: 600; }
  .destacado .mas { border-color: var(--linea-oscura); }
  .precio .mes { font-size: 1.6rem; letter-spacing: -.03em; }
  .nota { font-size: .85rem; color: var(--texto-suave); }
  .incluye { list-style: none; display: grid; gap: 11px; margin: 24px 0 30px; font-size: .96rem; }
  .incluye li { display: flex; gap: 10px; }
  .incluye li::before { content: "✓"; flex: none; font-weight: 800; color: var(--bordo); }
  .destacado .incluye li::before { color: var(--rosa); }
  /* Beneficio de lanzamiento: se distingue del resto sin cartel extra */
  .incluye .extra { font-weight: 700; color: var(--bordo); }
  .destacado .incluye .extra { color: var(--rosa); }
  .plan .btn { margin-top: auto; width: 100%; }
  .precio b { font-variant-numeric: tabular-nums; }

  /* Recomendado: borde con un brillo que da la vuelta a la tarjeta */
  @property --ang { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .destacado { border: 2px solid transparent; background: linear-gradient(var(--vino), var(--vino)) padding-box, conic-gradient(from var(--ang), var(--vino) 0 45%, var(--bordo-hover) 62%, var(--rosa) 75%, #FFF4F8 80%, var(--rosa) 85%, var(--bordo-hover) 92%, var(--vino)) border-box; box-shadow: 0 34px 70px -34px #782D4DCC; animation: vuelta 4s linear infinite, respira 3.2s ease-in-out infinite; }
  @keyframes vuelta { to { --ang: 360deg; } }
  @keyframes respira { 50% { box-shadow: 0 40px 100px -28px #B04A7AE6; } }
  /* En escritorio la recomendada queda un poco más grande que la otra */
  @media (min-width: 701px) { .destacado { scale: 1.04; } }
  .destacado:hover { border-color: transparent; }
  .sello { background: linear-gradient(100deg, var(--rosa) 40%, #FFF4F8 50%, var(--rosa) 60%) 0 0 / 300% 100%; animation: destello 4s var(--ease) infinite; }
  @keyframes destello { 0%, 40% { background-position: 100% 0; } 100% { background-position: 0 0; } }

  /* "Quiero este plan": un reflejo cruza el botón cada tanto (los dos botones van desfasados) */
  .plan .btn::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(110deg, transparent 30%, #FFFFFF8C 50%, transparent 70%); transform: translateX(-110%); animation: reflejo 3.2s var(--ease) infinite 1s; pointer-events: none; }
  .plan .btn-claro::after { background: linear-gradient(110deg, transparent 30%, #E9C9D5 50%, transparent 70%); animation-delay: 2.6s; }
  @keyframes reflejo { 0% { transform: translateX(-110%); } 35%, 100% { transform: translateX(110%); } }
  .plan .btn .flecha { animation: empuja 3.2s var(--ease) infinite 1s; }
  .plan .btn-claro .flecha { animation-delay: 2.6s; }
  @keyframes empuja { 12% { transform: translateX(7px); } 24%, 100% { transform: none; } }
  /* Onda que sale del botón, como un llamado a tocarlo */
  .plan .btn { animation: llamado 2.4s var(--ease) infinite; }
  .plan .btn-claro { --onda: #E9C9D5; animation-delay: 1.2s; }
  @keyframes llamado { from { box-shadow: 0 0 0 0 var(--onda, #782D4D80); } 70%, to { box-shadow: 0 0 0 14px transparent; } }

  /* Lo que incluye entra renglón por renglón detrás de la tarjeta */
  :global(.js) .incluye li { opacity: 0; transform: translateX(-10px); transition: opacity .5s var(--ease), transform .5s var(--ease); transition-delay: calc(var(--d, 0s) + .35s + var(--i) * 60ms); }
  :global(.js) .plan.in .incluye li { opacity: 1; transform: none; }

  @media (hover: hover) and (pointer: fine) {
    /* Luz que sigue al mouse */
    .plan::after { content: ""; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), #E9C9D566, transparent 45%); opacity: 0; transition: opacity .3s; pointer-events: none; }
    .destacado::after { background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 0%), #FFFFFF1F, transparent 45%); }
    .plan:hover::after { opacity: 1; }
    .plan.tilt { transition: transform .2s var(--ease), box-shadow .4s, border-color .3s; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .incluye li { opacity: 1; transform: none; }
  }

  .condiciones { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin-top: 28px; color: var(--texto-suave); font-size: .92rem; font-weight: 600; }
  .condiciones li { display: flex; align-items: center; gap: 10px; }
  .condiciones li::before { content: ""; width: 7px; height: 7px; border-radius: 2px; rotate: 45deg; background: var(--bordo); }

  .aparte { max-width: 760px; margin: 22px auto 0; text-align: center; color: var(--texto-suave); font-size: .9rem; }

  @media (max-width: 960px) {
    .cabecera { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .planes { grid-template-columns: 1fr; max-width: 560px; }
    .para { min-height: 0; }
  }
  @media (max-width: 480px) {
    .plan { padding: 30px 22px 24px; }
  }
</style>
