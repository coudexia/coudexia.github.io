---
import { PLANES, LANZAMIENTO, wa } from '../data/coudexia';
---
<section class="seccion" id="precios">
  <div class="wrap">
    <div class="cabecera">
      <div>
        <p class="etiqueta rv">Planes y precios</p>
        <h2 class="rv palabras">Elegí tu plan y arrancamos.</h2>
      </div>
      <p class="bajada rv">Precios en pesos argentinos. Escribinos por WhatsApp con el plan que te interesa: en Página Start y Página Business, en 48 h te mostramos un borrador gratis.</p>
    </div>

    <div id="planes" class="ancla">
    {LANZAMIENTO.cupos > 0 && (
      <p class="lanza rv"><b>Precio de lanzamiento</b> para los primeros {LANZAMIENTO.cupos} clientes <span aria-hidden="true">·</span> Incluye el primer mes de mantenimiento bonificado</p>
    )}

    <ul class="planes">
      {PLANES.map((p, i) => (
        <li class:list={['plan rv', { destacado: p.destacado }]} style={`--d:${i * .1}s`}>
          {p.destacado && <span class="sello">Recomendado</span>}
          <p class="nombre">{p.nombre}</p>
          <p class="para">{p.para}</p>
          <p class="precio">
            {p.desde ? <><small>Desde</small><b>{p.desde}</b><span class="unico">Pago único</span></> : <b class="consultar">A consultar</b>}
          </p>
          {p.nota && <p class="nota">{p.nota}</p>}
          <ul class="incluye">
            {p.incluye.map((it) => <li>{it}</li>)}
            {LANZAMIENTO.cupos > 0 && <li class="extra">1.er mes de mantenimiento bonificado</li>}
          </ul>
          <a class:list={['btn', p.destacado ? 'btn-claro' : 'btn-principal']} href={wa(p.mensaje)} target="_blank" rel="noopener">Quiero la {p.nombre} <span class="flecha" aria-hidden="true">→</span></a>
        </li>
      ))}
    </ul>
    </div>

    <ul class="condiciones rv">
      <li>Pago único, sin abonos mensuales obligatorios</li>
      <li>50% al confirmar y 50% en la entrega</li>
      <li>Transferencia o Mercado Pago</li>
      <li>Dominio y web a tu nombre</li>
    </ul>

    <a class="idea rv" href="#contacto">
      <span class="idea-txt"><b>¿Tenés una idea que no está en las opciones?</b> Contanosla y te armamos el presupuesto.</span>
      <span class="idea-ir" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .cabecera { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 20px 64px; align-items: end; margin-bottom: clamp(40px, 6vw, 64px); }
  .cabecera h2 { margin-top: 18px; }
  /* Destino de los links "Ver Página…" de Servicios: deja el aviso y los planes a la vista */
  .ancla { scroll-margin-top: 24px; }
  /* Aviso de lanzamiento: sin precio tachado, el beneficio es real y tiene límite */
  .lanza { width: fit-content; margin: 0 auto 34px; padding: 10px 20px; border-radius: 999px; background: var(--rosa); color: var(--vino); font-size: .93rem; font-weight: 600; text-align: center; }
  .lanza b { font-weight: 800; }
  .planes { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .plan { position: relative; display: flex; flex-direction: column; padding: 34px 30px 30px; background: var(--papel); border: 1px solid var(--linea); border-radius: 22px; transition: opacity .8s var(--ease), transform .8s var(--ease), box-shadow .4s, border-color .3s; transition-delay: var(--d, 0s), var(--d, 0s), 0s, 0s; }
  .js .plan.rv.in:hover { transform: translateY(-6px); }
  .plan:hover { border-color: #D8C6CD; box-shadow: 0 30px 60px -32px #501B3566; }
  .destacado { background: var(--vino); color: var(--marfil); border-color: var(--vino); }
  .sello { position: absolute; top: -13px; left: 30px; padding: 5px 12px; border-radius: 999px; background: var(--rosa); color: var(--vino); font-size: .75rem; font-weight: 800; letter-spacing: .04em; }
  .nombre { font-size: 1.6rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
  .para { margin-top: 10px; color: var(--texto-suave); font-size: .97rem; min-height: 3.2em; }
  .destacado .para, .destacado .nota { color: #D9C3CC; }
  .precio { display: grid; margin: 26px 0 4px; padding-top: 22px; border-top: 1px solid var(--linea); }
  .destacado .precio { border-color: var(--linea-oscura); }
  .precio small { font-size: .82rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--bordo); }
  .destacado .precio small { color: var(--rosa); }
  .precio b { font-size: clamp(2.2rem, 3.6vw, 2.8rem); font-weight: 800; letter-spacing: -.04em; line-height: 1.1; }
  .unico { margin-top: 4px; font-size: .85rem; font-weight: 600; color: var(--texto-suave); }
  .destacado .unico { color: #D9C3CC; }
  .nota { font-size: .85rem; color: var(--texto-suave); }
  .incluye { list-style: none; display: grid; gap: 11px; margin: 24px 0 30px; font-size: .96rem; }
  .incluye li { display: flex; gap: 10px; }
  .incluye li::before { content: "✓"; flex: none; font-weight: 800; color: var(--bordo); }
  .destacado .incluye li::before { color: var(--rosa); }
  /* Beneficio de lanzamiento: se distingue del resto sin cartel extra */
  .incluye .extra { font-weight: 700; color: var(--bordo); }
  .destacado .incluye .extra { color: var(--rosa); }
  .plan .btn { margin-top: auto; width: 100%; }

  .condiciones { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin-top: 28px; color: var(--texto-suave); font-size: .92rem; font-weight: 600; }
  .condiciones li { display: flex; align-items: center; gap: 10px; }
  .condiciones li::before { content: ""; width: 7px; height: 7px; border-radius: 2px; rotate: 45deg; background: var(--bordo); }

  /* Acceso al formulario de ideas a medida */
  .idea { position: relative; isolation: isolate; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 40px; padding: clamp(24px, 4vw, 36px) clamp(22px, 4vw, 40px); border: 1.5px solid var(--grafito); border-radius: 22px; text-decoration: none; font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .idea::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--grafito); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); }
  .idea b { font-weight: 800; letter-spacing: -.02em; }
  .idea-txt { color: var(--texto-suave); transition: color .3s; }
  .idea-txt b { color: var(--grafito); transition: color .3s; }
  .idea-ir { flex: none; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--bordo); color: var(--marfil); font-size: 1.3rem; transition: transform .5s var(--ease), background-color .3s; }
  .idea:hover::before { transform: none; }
  .idea:hover .idea-txt { color: #CFC6CA; }
  .idea:hover .idea-txt b { color: var(--marfil); }
  .idea:hover .idea-ir { transform: rotate(-45deg); background: var(--rosa); color: var(--vino); }

  @media (max-width: 960px) {
    .cabecera { grid-template-columns: 1fr; }
    .planes { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
    .para { min-height: 0; }
    .lanza { border-radius: 18px; }
  }
  @media (max-width: 480px) {
    .plan { padding: 30px 22px 24px; }
    .idea-ir { width: 46px; height: 46px; }
  }
</style>
