---
// Por qué un negocio con turnos necesita una web. Cada tarjeta tiene dos caras:
// [problema hoy, detalle] y [con la web, detalle]. El selector alterna entre las dos.
const puntos = [
  [['¿Será un negocio serio?', 'Sin web propia, quien no te conoce duda antes de escribirte.'],
   ['Confianza desde el primer vistazo', 'Una web propia, con tu marca y tu dominio, muestra un negocio serio antes de que te escriban.']],
  [['«Precio por privado»', 'Tiene que preguntar cuánto sale y esperar a que le contestes.'],
   ['Servicios y precios claros', 'Todo en un solo lugar, sin que tengan que preguntar por mensaje ni buscar entre historias destacadas.']],
  [['Consultas que se pierden', 'Entre Instagram, WhatsApp y los comentarios, alguna queda sin responder.'],
   ['Contacto en un toque', 'Botones de WhatsApp con el mensaje ya armado y tu ubicación en el mapa.']],
  [['Ida y vuelta por cada turno', '«¿Tenés el jueves?» «¿Y a las 5?» Varios mensajes para cerrar un solo horario.'],
   ['Turnos sin ida y vuelta', 'Tus clientes ven los horarios libres y reservan solos, a cualquier hora.']],
];
---
<section class="seccion problema" id="por-que" data-modo="con">
  <div class="wrap">
    <div class="cabecera">
      <p class="etiqueta rv">Por qué una web</p>
      <h2 class="rv palabras">Tu Instagram muestra tu trabajo. Tu web consigue el turno.</h2>
      <p class="bajada rv">Quien te descubre quiere saber qué hacés, cuánto sale y cuándo tenés lugar. Si para eso tiene que escribirte y esperar la respuesta, muchas veces sigue de largo.</p>
    </div>

    <div class="selector rv" role="group" aria-label="Comparar">
      <button type="button" data-modo="sin" aria-pressed="false">Solo con Instagram</button>
      <button type="button" data-modo="con" aria-pressed="true">Con tu web</button>
    </div>

    <ul class="puntos">
      {puntos.map(([sin, con], i) => (
        <li class="rv" style={`--d:${i * .08}s; --i:${i}`}>
          <div class="cara sin" aria-hidden="true"><span class="marca">✕</span><h3>{sin[0]}</h3><p>{sin[1]}</p></div>
          <div class="cara con"><span class="marca">✓</span><h3>{con[0]}</h3><p>{con[1]}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('#por-que')!;
  const botones = sec.querySelectorAll<HTMLButtonElement>('.selector button');
  const modo = (m: string) => {
    sec.dataset.modo = m;
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modo === m)));
    sec.querySelectorAll('.cara').forEach((c) => c.setAttribute('aria-hidden', String(!c.classList.contains(m))));
  };
  botones.forEach((b) => b.addEventListener('click', () => modo(b.dataset.modo!)));

  // La primera vez que se ve, arranca en el problema y pasa sola a la solución
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    modo('sin');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      setTimeout(() => { if (sec.dataset.modo === 'sin') modo('con'); }, 1800);
    }, { threshold: .6 });
    io.observe(sec.querySelector('.puntos')!);
  }
</script>

<style>
  .problema { background: var(--papel); border-bottom: 1px solid var(--linea); }
  .cabecera { display: grid; gap: 18px; max-width: 820px; margin-bottom: clamp(28px, 4vw, 40px); }

  /* Selector con una pastilla que se desliza al modo elegido */
  .selector { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; margin-bottom: 22px; padding: 5px; border-radius: 999px; background: #EFE9E5; }
  .selector::before { content: ""; position: absolute; inset: 5px 50% 5px 5px; border-radius: 999px; background: var(--grafito); transition: transform .5s var(--ease), background-color .4s; }
  [data-modo="con"] .selector::before { transform: translateX(100%); background: var(--bordo); }
  .selector button { position: relative; min-height: 44px; padding: 0 20px; border: 0; border-radius: 999px; background: none; font-weight: 700; font-size: .92rem; color: var(--texto-suave); white-space: nowrap; cursor: pointer; transition: color .3s; }
  .selector button[aria-pressed="true"] { color: var(--marfil); }

  .puntos { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .puntos li { display: grid; border: 1px solid var(--linea); border-radius: 22px; background: var(--marfil); transition: opacity .8s var(--ease), transform .8s var(--ease), border-color .4s; transition-delay: var(--d, 0s), var(--d, 0s), calc(var(--i) * 70ms); }
  [data-modo="con"] .puntos li { border-color: #D8C6CD; }
  /* Las dos caras ocupan el mismo lugar: una sale hacia arriba y la otra entra desde abajo, tarjeta por tarjeta */
  .cara { grid-area: 1 / 1; padding: 24px 22px 26px; transition: opacity .35s, transform .5s var(--ease); transition-delay: calc(var(--i) * 70ms); }
  [data-modo="con"] .sin { opacity: 0; transform: translateY(-10px); }
  [data-modo="sin"] .con { opacity: 0; transform: translateY(10px); }
  .marca { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; font-size: .78rem; font-weight: 800; }
  .sin .marca { background: #EFE9E5; color: var(--texto-suave); }
  .con .marca { background: var(--rosa); color: var(--vino); }
  h3 { font-size: 1.25rem; letter-spacing: -.02em; margin: 14px 0 8px; }
  .sin h3 { color: var(--texto-suave); }
  .cara p { color: var(--texto-suave); font-size: .97rem; }

  @media (hover: hover) and (pointer: fine) {
    .selector button:hover { color: var(--grafito); }
    .selector button[aria-pressed="true"]:hover { color: var(--marfil); }
  }
  @media (max-width: 960px) { .puntos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .puntos { grid-template-columns: 1fr; gap: 12px; }
    .selector { display: grid; }
    .selector button { padding: 0 10px; font-size: .88rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sin, .con { transform: none !important; }
  }
</style>
