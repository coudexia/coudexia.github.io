---
import { FAQ } from '../data/coudexia';
// Datos estructurados para que Google pueda mostrar las preguntas
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r } })) };
---
<section class="seccion" id="preguntas">
  <div class="wrap grilla">
    <div class="cabecera">
      <p class="etiqueta rv">Preguntas frecuentes</p>
      <h2 class="rv">Lo que suelen preguntarnos.</h2>
    </div>
    <div class="lista">
      {FAQ.map((f, i) => (
        <details class="item rv" open={i === 0}>
          <summary><span>{f.p}</span><i aria-hidden="true"></i></summary>
          <p>{f.r}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .grilla { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 32px clamp(40px, 7vw, 96px); align-items: start; }
  .cabecera { display: grid; gap: 18px; }
  .lista { border-top: 1px solid var(--grafito); }
  .item { border-bottom: 1px solid var(--linea); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 24px 0; font-weight: 700; font-size: 1.15rem; letter-spacing: -.01em; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--bordo); }
  summary i { position: relative; flex: none; width: 30px; height: 30px; border-radius: 50%; border: 1.5px solid currentColor; }
  summary i::before, summary i::after { content: ""; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); transition: transform .3s var(--ease); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  [open] summary i::after { transform: translate(-50%, -50%) rotate(0deg); }
  .item p { padding: 0 48px 26px 0; color: var(--texto-suave); max-width: 680px; }
  @media (max-width: 860px) { .grilla { grid-template-columns: 1fr; } .item p { padding-right: 0; } }
</style>
