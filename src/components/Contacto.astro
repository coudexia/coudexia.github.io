---
import { CONTACTO, PLANES, wa } from '../data/coudexia';
const tipos = [...PLANES.map((p) => `${p.nombre}`), 'Desarrollo a medida', 'Todavía no sé'];
const tel = CONTACTO.telefono.replace(/[^+\d]/g, '');
---
<section class="seccion contacto" id="contacto">
  <div class="wrap grilla">
    <div class="texto">
      <p class="etiqueta rv">Contacto</p>
      <h2 class="rv">Empecemos tu proyecto.</h2>
      <p class="bajada rv">Contanos qué necesitás y te respondemos con una propuesta. Si es una web Start o Business, en 48 h tenés un borrador gratis para ver cómo quedaría.</p>
      <ul class="canales rv">
        <li><a href={wa()} target="_blank" rel="noopener"><small>WhatsApp</small>{CONTACTO.telefono}</a></li>
        <li><a href={`mailto:${CONTACTO.email}`}><small>Email</small>{CONTACTO.email}</a></li>
        {CONTACTO.ciudad && <li><span><small>Ubicación</small>{CONTACTO.ciudad} · trabajamos de forma remota</span></li>}
      </ul>
    </div>

    <form class="form rv" novalidate data-wa={CONTACTO.whatsapp}>
      <h3>Solicitar presupuesto</h3>
      <div class="campo">
        <label for="f-nombre">Tu nombre</label>
        <input id="f-nombre" name="nombre" autocomplete="name" required aria-describedby="e-nombre" />
        <p class="error" id="e-nombre" aria-live="polite"></p>
      </div>
      <div class="campo">
        <label for="f-negocio">Tu negocio o rubro <span>(opcional)</span></label>
        <input id="f-negocio" name="negocio" autocomplete="organization" placeholder="Consultorio odontológico en Belgrano" />
      </div>
      <div class="campo">
        <label for="f-tipo">¿Qué necesitás?</label>
        <select id="f-tipo" name="tipo" required aria-describedby="e-tipo">
          <option value="">Elegí una opción</option>
          {tipos.map((t) => <option>{t}</option>)}
        </select>
        <p class="error" id="e-tipo" aria-live="polite"></p>
      </div>
      <div class="campo">
        <label for="f-mensaje">Contanos un poco más <span>(opcional)</span></label>
        <textarea id="f-mensaje" name="mensaje" rows="3" placeholder="Qué querés mostrar, si ya tenés dominio, fecha que te gustaría tenerla…"></textarea>
      </div>
      <button class="btn btn-principal" type="submit">Enviar por WhatsApp</button>
      <p class="aviso" aria-live="polite">Se abre WhatsApp con tu consulta armada, lista para enviar.</p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.form')!;
  const aviso = form.querySelector<HTMLElement>('.aviso')!;
  const campos = ['nombre', 'tipo'] as const;
  const mensajes = { nombre: 'Escribí tu nombre para saber cómo llamarte.', tipo: 'Elegí qué necesitás, aunque sea "Todavía no sé".' };
  const marcar = (n: (typeof campos)[number], ok: boolean) => {
    const el = form.elements.namedItem(n) as HTMLInputElement;
    el.setAttribute('aria-invalid', String(!ok));
    form.querySelector(`#e-${n}`)!.textContent = ok ? '' : mensajes[n];
    return ok;
  };
  campos.forEach((n) => (form.elements.namedItem(n) as HTMLElement).addEventListener('input', () => marcar(n, true)));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const validos = campos.map((n) => marcar(n, !!d[n]?.trim()));
    if (validos.includes(false)) { (form.querySelector('[aria-invalid="true"]') as HTMLElement).focus(); return; }
    const texto = [
      `Hola Coudexia! Soy ${d.nombre.trim()}.`,
      d.negocio?.trim() && `Mi negocio: ${d.negocio.trim()}.`,
      `Necesito: ${d.tipo}.`,
      d.mensaje?.trim(),
    ].filter(Boolean).join('\n');
    const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(texto)}`;
    // Link real en pestaña nueva (window.open con noopener devuelve null y no sirve para detectar bloqueos)
    Object.assign(document.createElement('a'), { href: url, target: '_blank', rel: 'noopener' }).click();
    aviso.innerHTML = `Listo: se abrió WhatsApp con tu consulta. Si no se abrió, <a href="${url}" target="_blank" rel="noopener">tocá acá</a>.`;
  });
</script>

<style>
  .contacto { background: var(--vino); color: var(--marfil); }
  .contacto .etiqueta { color: var(--rosa); }
  .contacto .bajada { color: #D9C3CC; }
  .grilla { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px clamp(40px, 7vw, 96px); align-items: start; }
  .texto { display: grid; gap: 20px; }
  h2 { font-size: clamp(2.4rem, 5.6vw, 4.2rem); }
  .canales { list-style: none; margin-top: 16px; border-top: 1px solid var(--linea-oscura); }
  .canales li { border-bottom: 1px solid var(--linea-oscura); }
  .canales a, .canales span { display: grid; gap: 2px; padding: 16px 0; text-decoration: none; font-weight: 700; font-size: 1.05rem; overflow-wrap: anywhere; }
  .canales a:hover { color: var(--rosa); }
  .canales small { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--rosa); font-weight: 700; }

  .form { display: grid; gap: 18px; padding: clamp(26px, 4vw, 40px); background: var(--marfil); color: var(--grafito); border-radius: 24px; }
  .form h3 { font-size: 1.6rem; }
  .campo { display: grid; gap: 7px; }
  label { font-weight: 700; font-size: .92rem; }
  label span { font-weight: 500; color: var(--texto-suave); }
  input, select, textarea { width: 100%; min-height: 50px; padding: 12px 14px; border: 1.5px solid var(--linea); border-radius: 12px; background: var(--papel); font-size: 1rem; transition: border-color .2s; }
  textarea { resize: vertical; min-height: 96px; }
  input::placeholder, textarea::placeholder { color: #9A8F94; }
  input:hover, select:hover, textarea:hover { border-color: #C9BDB8; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--bordo); box-shadow: 0 0 0 3px #782D4D22; }
  [aria-invalid="true"] { border-color: #B3261E; }
  .error { min-height: 0; font-size: .86rem; font-weight: 600; color: #B3261E; }
  .error:empty { display: none; }
  .form .btn { width: 100%; margin-top: 4px; }
  .aviso { font-size: .86rem; color: var(--texto-suave); text-align: center; }
  .aviso :global(a) { color: var(--bordo); font-weight: 700; }

  @media (max-width: 860px) { .grilla { grid-template-columns: 1fr; } }
</style>
