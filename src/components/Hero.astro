---
import { RUBROS } from '../data/coudexia';
const titulo = 'Tu WhatsApp responde y agenda turnos'.split(' ');
// Charla de ejemplo con la demo Aura Láser: [quién, texto]. Se muestra sola, mensaje por mensaje.
const charla = [
  ['clienta', 'Hola! Cuánto sale piernas completas + axilas?'],
  ['bot', '¡Hola! 😊 Piernas completas + axilas sale <b>$41.000</b> por sesión. Si querés, empezás con una evaluación gratis.'],
  ['clienta', 'Dale! Tenés el jueves a la tarde?'],
  ['bot', 'El jueves tengo <b>16:00</b>, <b>17:30</b> o <b>18:00</b>. ¿Cuál te queda mejor?'],
  ['clienta', '17:30 🙌 Soy Sofi'],
  ['bot', '¡Listo, Sofi! Te agendé la evaluación el <b>jueves a las 17:30</b>. Te esperamos en Av. Santa Fe 1960 💜'],
];
---
<section class="hero" id="inicio">
  <div class="wrap grilla">
    <div class="texto">
      <p class="etiqueta entra" style="--d:.05s"><span class="punto" aria-hidden="true"></span>Web · Recepcionista con IA · WhatsApp</p>
      <h1 aria-label="Tu WhatsApp responde y agenda turnos solo.">
        {titulo.map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{' '}</>)}
        <span class="w" aria-hidden="true"><em style={`--i:${titulo.length}`}>solo.</em></span>
      </h1>
      <p class="bajada entra" style="--d:.55s">Una recepcionista con IA que contesta precios, consulta tu agenda y reserva turnos las 24 h, junto con una web profesional para tu negocio. Nosotros la armamos y la mantenemos.</p>
      <div class="acciones entra" style="--d:.65s">
        <a class="btn btn-principal" href="#planes">Ver planes y precios</a>
        <a class="btn btn-borde" href="#servicios">Cómo funciona <span class="flecha" aria-hidden="true">→</span></a>
      </div>
      <ul class="promesas entra" style="--d:.8s">
        <li>Responde en segundos, las 24 h</li>
        <li>Te pasa la charla cuando hace falta</li>
        <li>Sin permanencia mínima</li>
      </ul>
    </div>

    <div class="escena entra" style="--d:.35s" aria-hidden="true">
      <div class="aro a1"></div><div class="aro a2"></div>
      <div class="celular">
        <div class="chat-top"><span class="avatar">AL</span><span><b>Aura Láser</b><small class="estado">en línea</small></span></div>
        <div class="mensajes">
          {charla.map(([quien, texto]) => <p class:list={['msj', quien]} set:html={texto} />)}
          <p class="msj bot escribiendo"><i></i><i></i><i></i></p>
        </div>
      </div>
      <div class="chip agendado"><span class="vivo"></span>Turno agendado · jue 17:30</div>
      <div class="chip demo">Charla de ejemplo · negocio ficticio</div>
    </div>
  </div>

  <div class="cinta" aria-label={`Para ${RUBROS.join(', ')}`}>
    <div class="pista" aria-hidden="true">
      {[0, 1].map(() => <ul>{RUBROS.map((r) => <li>{r}</li>)}</ul>)}
    </div>
  </div>
</section>

<script>
  // La charla aparece mensaje por mensaje (con "escribiendo…" antes de cada respuesta) y vuelve a empezar
  const escena = document.querySelector<HTMLElement>('.escena')!;
  const msjs = [...escena.querySelectorAll<HTMLElement>('.msj:not(.escribiendo)')];
  const escribiendo = escena.querySelector<HTMLElement>('.escribiendo')!;
  const estado = escena.querySelector('.estado')!;
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (calmo) escena.classList.add('fin');
  else {
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visible = false, corriendo = false;
    const ciclo = async () => {
      corriendo = true;
      while (visible) {
        escena.classList.remove('fin');
        msjs.forEach((m) => m.classList.remove('on'));
        await espera(700);
        for (const m of msjs) {
          if (!visible) break;
          if (m.classList.contains('bot')) {
            escribiendo.classList.add('on'); estado.textContent = 'escribiendo…';
            await espera(1300);
            escribiendo.classList.remove('on'); estado.textContent = 'en línea';
          }
          m.classList.add('on');
          await espera(m.classList.contains('bot') ? 2200 : 1100);
        }
        escena.classList.add('fin');
        await espera(4500);
      }
      corriendo = false;
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !corriendo) ciclo();
    }).observe(escena);
  }
</script>

<style>
  .hero { padding: clamp(40px, 6vw, 72px) 0 0; overflow: hidden; }
  .grilla { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--bordo); box-shadow: 0 0 0 0 #782D4D66; animation: latido 2.4s infinite; }
  .etiqueta:has(.punto)::before { display: none; }
  @keyframes latido { 70% { box-shadow: 0 0 0 9px #782D4D00; } 100% { box-shadow: 0 0 0 0 #782D4D00; } }
  h1 { font-size: clamp(2.5rem, 5.8vw, 4.7rem); margin: 22px 0 24px; }
  h1 .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .1em; margin-bottom: -.1em; }
  h1 .w > * { display: inline-block; animation: sube 1s var(--ease) both; animation-delay: calc(.1s + var(--i) * 60ms); }
  h1 em { font-style: normal; color: var(--bordo); }
  @keyframes sube { from { transform: translateY(105%); } }
  .entra { animation: aparece .9s var(--ease) both; animation-delay: var(--d); }
  @keyframes aparece { from { opacity: 0; transform: translateY(18px); } }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  /* Bloque vino con un celular y la charla de WhatsApp */
  .escena { position: relative; display: grid; place-items: center; padding: 40px 24px 64px; background: var(--vino); border-radius: 28px; overflow: hidden; }
  .aro { position: absolute; border-radius: 50%; border: 1px solid var(--linea-oscura); aspect-ratio: 1; animation: gira 40s linear infinite; }
  .a1 { width: 90%; right: -30%; bottom: -40%; }
  .a2 { width: 60%; left: -20%; top: -18%; border-style: dashed; animation-direction: reverse; }
  @keyframes gira { to { rotate: 360deg; } }
  .celular { position: relative; z-index: 1; width: min(100%, 340px); padding: 8px; background: var(--grafito); border-radius: 34px; box-shadow: 0 30px 60px -20px #1a0610cc; }
  .chat-top { display: flex; align-items: center; gap: 10px; padding: 14px 16px 12px; border-radius: 26px 26px 0 0; background: #1F5C4B; color: #fff; font-size: .85rem; }
  .chat-top b { display: block; line-height: 1.2; }
  .chat-top small { opacity: .85; }
  .avatar { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--rosa); color: var(--vino); font-weight: 800; font-size: .72rem; }
  .mensajes { display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; height: 400px; padding: 14px 12px; overflow: hidden; border-radius: 0 0 26px 26px; background: #EFE7DE; color: var(--grafito); }
  .msj { max-width: 84%; padding: 8px 11px; font-size: .86rem; line-height: 1.4; box-shadow: 0 1px 1px #0001; }
  .msj :global(b) { font-weight: 800; }
  .clienta { align-self: flex-end; border-radius: 12px 12px 2px 12px; background: #D9FDD3; }
  .bot { align-self: flex-start; border-radius: 12px 12px 12px 2px; background: #fff; }
  /* Los mensajes que todavía no llegaron no ocupan lugar; al aparecer empujan la charla hacia arriba */
  :global(.js) .msj { display: none; animation: llega .45s var(--ease); }
  :global(.js) .msj.on, .fin .msj:not(.escribiendo) { display: block; }
  @keyframes llega { from { opacity: 0; transform: translateY(10px) scale(.97); } }
  .escribiendo { gap: 4px; padding: 12px 14px; }
  :global(.js) .escribiendo.on { display: flex; }
  .escribiendo i { width: 6px; height: 6px; border-radius: 50%; background: #9A8F94; animation: salta 1.2s infinite; }
  .escribiendo i:nth-child(2) { animation-delay: .15s; } .escribiendo i:nth-child(3) { animation-delay: .3s; }
  @keyframes salta { 30% { transform: translateY(-4px); } 60% { transform: none; } }

  .chip { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; font-size: .78rem; font-weight: 800; }
  .agendado { right: 6%; bottom: 72px; background: var(--marfil); color: var(--vino); box-shadow: 0 14px 30px -12px #1a0610cc; opacity: 0; transform: translateY(10px) scale(.95); transition: opacity .4s, transform .5s var(--ease); }
  .fin .agendado { opacity: 1; transform: none; }
  .vivo { width: 8px; height: 8px; border-radius: 50%; background: #2BB673; box-shadow: 0 0 0 0 #2BB67366; animation: latido 2s infinite; }
  .demo { left: 50%; bottom: 18px; translate: -50% 0; white-space: nowrap; color: #D9C3CC; font-weight: 600; font-size: .72rem; }

  .promesas { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 26px; font-size: .92rem; font-weight: 600; color: var(--texto-suave); }
  .promesas li { display: flex; align-items: center; gap: 8px; }
  .promesas li::before { content: "✓"; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--rosa); color: var(--vino); font-size: .7rem; font-weight: 800; }

  /* Cinta de rubros */
  .cinta { margin-top: clamp(48px, 7vw, 80px); border-block: 1px solid var(--linea); overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .pista { display: flex; width: max-content; animation: desliza 38s linear infinite; }
  .pista ul { display: flex; list-style: none; }
  .pista li { display: flex; align-items: center; gap: 28px; padding: 20px 28px 20px 0; font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 800; letter-spacing: -.02em; white-space: nowrap; }
  .pista li::after { content: ""; width: 9px; height: 9px; border-radius: 2px; background: var(--bordo); rotate: 45deg; }
  @keyframes desliza { to { transform: translateX(-50%); } }

  @media (max-width: 960px) {
    .grilla { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .escena { border-radius: 20px; padding: 28px 16px 60px; }
    .mensajes { height: 360px; }
    .agendado { right: 50%; translate: 50% 0; bottom: 58px; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Con "reducir movimiento" la charla se muestra completa y la cinta desfila más lento */
    .pista { animation-duration: 70s; }
  }
</style>
