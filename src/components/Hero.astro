---
import { RUBROS, wa } from '../data/coudexia';
const titulo = 'Una web profesional para que tus clientes reserven'.split(' ');
---
<section class="hero" id="inicio">
  <div class="wrap grilla">
    <div class="texto">
      <p class="etiqueta entra" style="--d:.05s"><span class="punto" aria-hidden="true"></span>Diseño web · Reservas online</p>
      <h1 aria-label="Una web profesional para que tus clientes reserven online.">
        {titulo.map((w, i) => <><span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{' '}</>)}
        <span class="w" aria-hidden="true"><em style={`--i:${titulo.length}`}>online.</em></span>
      </h1>
      <p class="bajada entra" style="--d:.55s">Diseñamos y desarrollamos la página de tu centro de estética, barbería o peluquería: tus servicios bien presentados, contacto directo por WhatsApp y un calendario para reservar turno en pocos pasos.</p>
      <div class="acciones entra" style="--d:.65s">
        <a class="btn btn-principal" href={wa()} target="_blank" rel="noopener">Hablemos por WhatsApp</a>
        <a class="btn btn-borde" href="#proyectos">Ver webs de ejemplo <span class="flecha" aria-hidden="true">→</span></a>
      </div>
      <ul class="promesas entra" style="--d:.8s">
        <li>Pensada primero para el celular</li>
        <li>Turnos directo a tu Google Calendar</li>
        <li>Dominio y web a tu nombre</li>
      </ul>
    </div>

    <!-- Reserva de ejemplo en la web de un negocio ficticio: los pasos aparecen de a uno -->
    <div class="escena entra" style="--d:.35s" aria-hidden="true">
      <div class="aro a1"></div><div class="aro a2"></div>
      <div class="celular">
        <p class="url"><span>🔒</span>tunegocio.com.ar</p>
        <div class="pantalla">
          <p class="negocio">Nácar Estética</p>
          <p class="reserva-titulo">Reservá tu turno</p>
          <div class="paso">
            <small>1 · Elegí el servicio</small>
            <ul class="servicios">
              <li class="sel"><b>Limpieza facial</b><span>60 min</span></li>
              <li><b>Lifting de pestañas</b><span>45 min</span></li>
            </ul>
          </div>
          <div class="paso">
            <small>2 · Elegí el horario · jueves</small>
            <ul class="horas"><li>16:00</li><li class="sel">17:30</li><li>18:00</li></ul>
          </div>
          <div class="paso listo">
            <span class="tilde">✓</span>
            <span><b>Turno confirmado</b><br />Limpieza facial · jueves 17:30</span>
          </div>
        </div>
      </div>
      <div class="chip agendado"><span class="vivo"></span>Nuevo turno en tu Google Calendar</div>
      <div class="chip demo">Reserva de ejemplo · negocio ficticio</div>
    </div>
  </div>

  <div class="cinta">
    <p class="solo-lector">Para {RUBROS.join(', ')}</p>
    <div class="pista" aria-hidden="true">
      {[0, 1].map(() => <ul>{RUBROS.map((r) => <li>{r}</li>)}</ul>)}
    </div>
  </div>
</section>

<script>
  // La reserva avanza sola, paso por paso, y vuelve a empezar
  const escena = document.querySelector<HTMLElement>('.escena')!;
  const pasos = [...escena.querySelectorAll<HTMLElement>('.paso')];
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (calmo) escena.classList.add('fin');
  else {
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visible = false, corriendo = false;
    const ciclo = async () => {
      corriendo = true;
      while (visible) {
        escena.classList.remove('fin');
        pasos.forEach((p) => p.classList.remove('on'));
        await espera(700);
        for (const p of pasos) {
          if (!visible) break;
          p.classList.add('on');
          await espera(1900);
        }
        escena.classList.add('fin');
        await espera(4500);
      }
      corriendo = false;
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !corriendo) ciclo();
    }).observe(escena);

    // El celular se inclina hacia el mouse (solo con mouse)
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const cel = escena.querySelector<HTMLElement>('.celular')!;
      escena.addEventListener('pointermove', (e) => {
        const r = escena.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
        cel.style.transform = `perspective(1000px) rotateX(${-y * 16}deg) rotateY(${x * 20}deg)`;
      });
      escena.addEventListener('pointerleave', () => { cel.style.transform = ''; });
    }
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; padding: clamp(40px, 6vw, 72px) 0 0; overflow: hidden; }
  /* Mancha de color que deriva despacio detrás del texto */
  .hero::before { content: ""; position: absolute; z-index: -1; left: -15%; top: -25%; width: min(70vw, 820px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, #E9C9D5, #E9C9D500); animation: deriva 12s ease-in-out infinite alternate; pointer-events: none; }
  @keyframes deriva { to { transform: translate(28%, 30%) scale(1.25); } }
  .grilla { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .punto { width: 8px; height: 8px; border-radius: 50%; background: var(--bordo); box-shadow: 0 0 0 0 #782D4D66; animation: latido 2.4s infinite; }
  .etiqueta:has(.punto)::before { display: none; }
  @keyframes latido { 70% { box-shadow: 0 0 0 9px #782D4D00; } 100% { box-shadow: 0 0 0 0 #782D4D00; } }
  h1 { font-size: clamp(2.4rem, 5.2vw, 4.2rem); margin: 22px 0 24px; }
  h1 .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: .1em; margin-bottom: -.1em; }
  h1 .w > * { display: inline-block; animation: sube 1s var(--ease) both; animation-delay: calc(.1s + var(--i) * 60ms); }
  h1 em { font-style: normal; color: var(--bordo); }
  @keyframes sube { from { transform: translateY(105%); } }
  .entra { animation: aparece .9s var(--ease) both; animation-delay: var(--d); }
  @keyframes aparece { from { opacity: 0; transform: translateY(18px); } }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  /* Bloque vino con un celular que muestra la web del negocio */
  .escena { position: relative; display: grid; place-items: center; padding: 40px 24px 100px; background: var(--vino); border-radius: 28px; overflow: hidden; }
  .aro { position: absolute; border-radius: 50%; border: 1px solid var(--linea-oscura); aspect-ratio: 1; animation: gira 40s linear infinite; }
  .a1 { width: 90%; right: -30%; bottom: -40%; }
  .a2 { width: 60%; left: -20%; top: -18%; border-style: dashed; animation-direction: reverse; }
  @keyframes gira { to { rotate: 360deg; } }
  .celular { position: relative; z-index: 1; width: min(100%, 340px); padding: 8px; background: var(--grafito); border-radius: 34px; box-shadow: 0 30px 60px -20px #1a0610cc; transition: transform .6s var(--ease); animation: flota 6s ease-in-out infinite; }
  /* Flota con "translate" para no pisar la inclinación, que usa "transform" */
  @keyframes flota { 50% { translate: 0 -16px; rotate: -1.5deg; } }
  .url { display: flex; align-items: center; justify-content: center; gap: 7px; padding: 10px 16px; border-radius: 26px 26px 0 0; background: #EFE9E5; color: var(--texto-suave); font-size: .78rem; font-weight: 600; }
  .pantalla { display: flex; flex-direction: column; gap: 14px; min-height: 400px; padding: 20px 16px 18px; border-radius: 0 0 26px 26px; background: var(--marfil); color: var(--grafito); }
  .negocio { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--bordo); }
  .reserva-titulo { margin-top: -10px; font-size: 1.45rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.15; }
  .paso small { display: block; margin-bottom: 8px; font-size: .74rem; font-weight: 700; color: var(--texto-suave); }
  .paso ul { list-style: none; display: grid; gap: 8px; }
  .paso li { padding: 10px 12px; border: 1.5px solid var(--linea); border-radius: 12px; background: var(--papel); font-size: .86rem; transition: background-color .35s, border-color .35s, color .35s; transition-delay: .7s; }
  .servicios li { display: flex; justify-content: space-between; gap: 10px; }
  .servicios span { color: var(--texto-suave); transition: inherit; }
  .horas { grid-template-columns: repeat(3, 1fr); text-align: center; font-weight: 700; }
  /* La opción elegida se marca un momento después de que aparece su paso */
  .paso.on .sel, .fin .sel { background: var(--bordo); border-color: var(--bordo); color: var(--marfil); }
  .paso.on .sel span, .fin .sel span { color: var(--rosa); }
  .listo { display: flex; align-items: center; gap: 12px; margin-top: auto; padding: 12px 14px; border-radius: 14px; background: var(--rosa); color: var(--vino); font-size: .84rem; line-height: 1.35; }
  .tilde { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--vino); color: var(--marfil); font-weight: 800; font-size: .8rem; }
  /* Sin JS se ve la reserva completa; con JS cada paso entra cuando le toca */
  :global(.js) .paso { opacity: 0; transform: translateY(10px); transition: opacity .45s, transform .45s var(--ease); }
  :global(.js) .paso.on, :global(.js) .fin .paso { opacity: 1; transform: none; }

  .chip { position: absolute; z-index: 2; display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; font-size: .78rem; font-weight: 800; white-space: nowrap; }
  .agendado { left: 50%; bottom: 48px; translate: -50% 0; background: var(--marfil); color: var(--vino); box-shadow: 0 14px 30px -12px #1a0610cc; opacity: 0; transform: translateY(10px) scale(.95); transition: opacity .4s, transform .5s var(--ease); }
  .fin .agendado { opacity: 1; transform: none; }
  .vivo { width: 8px; height: 8px; border-radius: 50%; background: #2BB673; box-shadow: 0 0 0 0 #2BB67366; animation: latido 2s infinite; }
  .demo { left: 50%; bottom: 16px; translate: -50% 0; color: #D9C3CC; font-weight: 600; font-size: .72rem; }

  .promesas { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 26px; font-size: .92rem; font-weight: 600; color: var(--texto-suave); }
  .promesas li { display: flex; align-items: center; gap: 8px; }
  .promesas li::before { content: "✓"; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--rosa); color: var(--vino); font-size: .7rem; font-weight: 800; }

  /* Cinta de rubros */
  .solo-lector { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .cinta { position: relative; margin-top: clamp(48px, 7vw, 80px); border-block: 1px solid var(--linea); overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .pista { display: flex; width: max-content; animation: desliza 38s linear infinite; }
  .pista ul { display: flex; list-style: none; }
  .pista li { display: flex; align-items: center; gap: 28px; padding: 20px 28px 20px 0; font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 800; letter-spacing: -.02em; white-space: nowrap; }
  .pista li::after { content: ""; width: 9px; height: 9px; border-radius: 2px; background: var(--bordo); rotate: 45deg; }
  @keyframes desliza { to { transform: translateX(-50%); } }

  @media (max-width: 960px) {
    .grilla { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .escena { border-radius: 20px; padding: 28px 16px 100px; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* Con "reducir movimiento" la reserva se muestra completa y la cinta desfila más lento */
    .pista { animation-duration: 70s; }
  }
</style>
