---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Proyectos from '../components/Proyectos.astro';
import Precios from '../components/Precios.astro';
import Problema from '../components/Problema.astro';
import Reservas from '../components/Reservas.astro';
import Proceso from '../components/Proceso.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { SITIO, CONTACTO } from '../data/coudexia';

// Datos de la empresa para Google
const ld = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'Coudexia',
  description: SITIO.descripcion, url: Astro.site!.href, image: new URL('/og.png', Astro.site).href,
  telephone: CONTACTO.telefono, email: CONTACTO.email, areaServed: 'AR',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
};
---
<Base title={SITIO.titulo} description={SITIO.descripcion}>
  <Header />
  <main id="contenido">
    <Hero />
    <Problema />
    <Servicios />
    <Reservas />
    <Proyectos />
    <Precios />
    <Proceso />
    <Faq />
    <Contacto />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script>
    // Títulos que entran palabra por palabra: se envuelve cada palabra (el texto sigue siendo el mismo para lectores de pantalla)
    document.querySelectorAll('.palabras').forEach((h) => {
      h.innerHTML = (h.textContent ?? '').trim().split(/\s+/).map((w, i) => `<span class="w"><span style="--i:${i}">${w}</span></span>`).join(' ');
    });
    // Aparición suave al hacer scroll (la clase "js" la pone Base.astro en el <head>)
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // Botones "magnéticos": siguen un poco al mouse (solo con mouse y sin "reducir movimiento")
    if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
      document.querySelectorAll<HTMLElement>('.btn').forEach((b) => {
        b.addEventListener('pointermove', (e) => {
          const r = b.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
          b.style.translate = `${x * 22}px ${y * 14}px`;
        });
        b.addEventListener('pointerleave', () => { b.style.translate = ''; });
      });
    }
  </script>
</Base>
