---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Página no encontrada · Coudexia" description="La página que buscás no existe.">
  <main id="contenido" class="nf">
    <a href="/" class="logo-link" aria-label="Coudexia, ir al inicio"><Logo /></a>
    <h1>Esta página no existe.</h1>
    <p>Puede que el link esté mal escrito o que la página se haya movido.</p>
    <a class="btn btn-principal" href="/">Volver al inicio</a>
  </main>
</Base>
<style>
  .nf { min-height: 100dvh; display: grid; place-content: center; justify-items: start; gap: 20px; width: min(640px, 100% - 40px); margin: auto; }
  .logo-link { font-size: 1.8rem; display: inline-flex; margin-bottom: 20px; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.4rem); }
  p { color: var(--texto-suave); }
</style>
